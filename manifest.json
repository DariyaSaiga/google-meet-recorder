{
  "manifest_version": 3,
  "name": "Google Meet Recorder",
  "version": "0.1.0",
  "description": "Record Google Meet meetings locally",

  "permissions": [
    "tabCapture",
    "activeTab",
    "offscreen",
    "downloads",
    "storage",
    "webNavigation"
  ],

  "background": {
    "service_worker": "service-worker.js"
  },

  "action": {
    "default_title": "Google Meet Recorder",
    "default_popup": "popup.html"
  },

  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": ["assets/cat-idle.png", "assets/cat-recording.png"],
      "matches": ["https://meet.google.com/*"]
    }
  ],

  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "platforms/google-meet.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": ["https://teams.live.com/*"],
      "js": ["platforms/teams.js", "content.js"],
      "css": ["content.css"]
    },
    {
      "matches": [
        "https://app.zoom.us/wc",
        "https://app.zoom.us/wc/*"
      ],
      "js": ["platforms/zoom.js", "content.js"],
      "css": ["content.css"],
      "all_frames": true
    }
  ]
}
